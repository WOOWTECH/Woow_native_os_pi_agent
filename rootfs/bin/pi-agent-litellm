#!/bin/bash
# pi-agent-litellm — point Pi at a LiteLLM (OpenAI-compatible) gateway.
#
# The key is stored once in $PI_AGENT_HOME/litellm.env (mode 600) and referenced
# from models.json as ${LITELLM_API_KEY}, so no credential is written into
# models.json itself. pi-agent-env.sh sources that file for every Pi process.
#
#   pi-agent-litellm set --base-url https://gw.example.com/v1 [--key-stdin|--key-env]
#   pi-agent-litellm refresh     # re-read the gateway's model list
#   pi-agent-litellm status
set -euo pipefail

SELF="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
: "${PI_AGENT_HOME:=$(dirname "$SELF")}"
export PI_AGENT_HOME
# shellcheck source=/dev/null
. "$PI_AGENT_HOME/bin/pi-agent-env.sh"

ENVFILE="$PI_AGENT_HOME/litellm.env"
MODELS="$PI_AGENT_DATA_DIR/models.json"
NODE="$PI_AGENT_HOME/node/bin/node"
PROVIDER=litellm

die(){ echo "pi-agent-litellm: $*" >&2; exit 1; }

read_base_url(){ [ -f "$ENVFILE" ] && sed -n 's/^LITELLM_BASE_URL=//p' "$ENVFILE" | tail -1; }

# Write the provider block into models.json, preserving every other provider.
# Model ids come from the gateway itself, so the menu matches what it serves.
write_models(){
  local base="$1" key="$2"
  local list; list="$(curl -fsS -m 25 -H "Authorization: Bearer $key" "${base%/}/models")" \
    || die "cannot list models at ${base%/}/models (check URL and key)"
  PROVIDER="$PROVIDER" BASE="$base" MODELS="$MODELS" "$NODE" -e '
    const fs=require("fs");
    const list=JSON.parse(fs.readFileSync(0,"utf8"));
    const ids=(list.data||[]).map(m=>m.id).filter(Boolean).sort();
    if(!ids.length) throw new Error("gateway returned no models");
    const f=process.env.MODELS;
    let cfg={};
    try{ cfg=JSON.parse(fs.readFileSync(f,"utf8")); }catch{}
    cfg["$schema"]=cfg["$schema"]||"https://pi.dev/schemas/models.schema.json";
    cfg.providers=cfg.providers||{};
    cfg.providers[process.env.PROVIDER]={
      baseUrl:process.env.BASE,
      api:"openai-completions",
      apiKey:"${LITELLM_API_KEY}",
      models:ids.map(id=>({id})),
    };
    fs.mkdirSync(require("path").dirname(f),{recursive:true});
    const tmp=f+"."+process.pid+".tmp";
    fs.writeFileSync(tmp,JSON.stringify(cfg,null,2)+"\n",{mode:0o600});
    fs.renameSync(tmp,f);
    console.log(ids.length);
  ' <<<"$list"
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  set)
    base=""; mode=stdin
    while [ $# -gt 0 ]; do
      case "$1" in
        --base-url) base="${2:-}"; shift 2 ;;
        --key-stdin) mode=stdin; shift ;;
        --key-env)   mode=env; shift ;;
        *) die "unknown option: $1" ;;
      esac
    done
    [ -n "$base" ] || die "--base-url is required (e.g. https://gw.example.com/v1)"
    case "$base" in https://*|http://*) ;; *) die "base URL must be http(s)" ;; esac
    if [ "$mode" = env ]; then
      key="${LITELLM_API_KEY:-}"; [ -n "$key" ] || die "LITELLM_API_KEY is empty"
    else
      [ -t 0 ] && echo "paste the LiteLLM key, then Ctrl-D:" >&2
      key="$(cat)"; key="${key//[$'\n\r\t ']/}"
      [ -n "$key" ] || die "no key on stdin"
    fi
    umask 077
    printf 'LITELLM_BASE_URL=%s\nLITELLM_API_KEY=%s\n' "$base" "$key" > "$ENVFILE"
    chmod 600 "$ENVFILE"
    n="$(write_models "$base" "$key")"
    echo "pi-agent-litellm: configured $PROVIDER at $base with $n model(s); key stored in $ENVFILE (mode 600)"
    echo "restart pi-web to pick it up:  pi-agent restart"
    ;;
  refresh)
    [ -f "$ENVFILE" ] || die "not configured yet; run 'pi-agent-litellm set --base-url ...' first"
    # shellcheck source=/dev/null
    . "$ENVFILE"
    n="$(write_models "$LITELLM_BASE_URL" "$LITELLM_API_KEY")"
    echo "pi-agent-litellm: refreshed $n model(s) from $LITELLM_BASE_URL"
    ;;
  status)
    base="$(read_base_url || true)"
    if [ -z "$base" ]; then echo "litellm: not configured"; exit 0; fi
    echo "litellm base url : $base"
    echo "key file         : $ENVFILE ($( [ -f "$ENVFILE" ] && stat -c %a "$ENVFILE" || echo missing ))"
    if [ -f "$MODELS" ]; then
      echo "models in config : $("$NODE" -e 'const c=require(process.argv[1]);console.log((c.providers?.litellm?.models||[]).length)' "$MODELS" 2>/dev/null || echo "?")"
      echo "key in models.json: $(grep -q '"apiKey": "\${LITELLM_API_KEY}"' "$MODELS" && echo 'by env reference (no plaintext)' || echo 'CHECK')"
    fi
    # shellcheck source=/dev/null
    [ -f "$ENVFILE" ] && . "$ENVFILE"
    echo "live check       : HTTP $(curl -sS -m 10 -o /dev/null -w '%{http_code}' -H "Authorization: Bearer ${LITELLM_API_KEY:-}" "${base%/}/models" 2>/dev/null || echo ERR)"
    ;;
  *) echo "usage: pi-agent-litellm {set --base-url URL [--key-stdin|--key-env] | refresh | status}"; exit 1 ;;
esac
