#!/bin/bash
# `pi` — launcher for the pi coding agent CLI/TUI.
#
# @earendil-works/pi-coding-agent declares bin.pi but ships only as a transitive
# dep of @agegr/pi-web, so npm never links its bin. Resolve it at runtime (a
# pi-web bump can move the nested path) and run it under the scoped Node.
set -euo pipefail

SELF="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
: "${PI_AGENT_HOME:=$(dirname "$SELF")}"
export PI_AGENT_HOME
# shellcheck source=/dev/null
_pa_caller_home="${HOME:-}"
. "${PI_AGENT_HOME}/bin/pi-agent-env.sh"
# Session home (docs/SESSION-HOME.md): pi-agent-env.sh scopes HOME for the
# install itself. While session home is enabled, keep the HOME this wrapper was
# called with instead: the Omnigent host now runs with the user's own HOME and
# hands it to its harnesses, so that is where their MCP servers, plugins, git
# identity and keys are. The state file, not an environment variable, is the
# signal -- omnigent starts harnesses with an allowlisted environment, so a
# variable such as PI_AGENT_SESSION_HOME never reaches this script. Keeping the
# caller's HOME (rather than forcing one) also leaves alone the private HOME
# omnigent gives each codex session, and the scoped HOME of pi-web's terminal.
if [ -f "${PI_AGENT_HOME}/session-home.state" ] && [ -n "${_pa_caller_home:-}" ]; then
  export HOME="$_pa_caller_home"
fi

CLI=""
for c in \
  "${PI_AGENT_HOME}/piweb/lib/node_modules/@agegr/pi-web/node_modules/@earendil-works/pi-coding-agent/dist/cli.js" \
  "${PI_AGENT_HOME}/piweb/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"
do
  [ -f "$c" ] && { CLI="$c"; break; }
done
[ -z "$CLI" ] && CLI="$(find "${PI_AGENT_HOME}/piweb" -path '*@earendil-works/pi-coding-agent/dist/cli.js' -print -quit 2>/dev/null || true)"
[ -z "$CLI" ] && { echo "pi: cannot locate pi-coding-agent cli.js under ${PI_AGENT_HOME}/piweb (packaging bug)" >&2; exit 127; }

exec "${PI_AGENT_HOME}/node/bin/node" "$CLI" "$@"
